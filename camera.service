[Unit]
Description=Camera Server (WebSockets + H264/TCP Stream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=camera
WorkingDirectory=/opt/smart-camera
ExecStart=/usr/bin/python3 /opt/smart-camera/server.py
Restart=always
RestartSec=5
# Ensure the entire process group (rpicam-vid child) is killed on stop
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
