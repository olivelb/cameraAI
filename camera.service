[Unit]
Description=Camera Server (WebSockets + H264/TCP Stream)
After=network.target

[Service]
Type=simple
User=camera
WorkingDirectory=/opt/smart-camera
ExecStart=/usr/bin/python /opt/smart-camera/server.py
Restart=always
RestartSec=5
# Ensure the entire process group (rpicam-vid child) is killed on stop
KillMode=process-group
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
